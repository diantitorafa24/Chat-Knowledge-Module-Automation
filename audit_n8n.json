/i.test(text);\n\n// Di PRIVATE chat: selalu layani (chat 1-on-1 langsung dengan bot)\nif (chatType === 'private') {\n  return [$input.first()];\n}\n\n// Di GRUP / SUPERGROUP:\n// WAJIB di-tag SPESIFIK (@cika_module_bot) ATAU mengandung kata \"cika\"\nif (isTagged || hasCikaKeyword) {\n  // Bersihkan HANYA tag @cika_module_bot dari pertanyaan\n  const cleanText = text.replace(/@cika_module_bot\\b/gi, '').trim();\n  const newItem = JSON.parse(JSON.stringify(item));\n  if (newItem.message.text) newItem.message.text = cleanText;\n  if (newItem.message.caption) newItem.message.caption = cleanText;\n  return [{ json: newItem }];\n}\n\n// Jika di grup dan tidak ada tag @cika_module_bot atau kata \"cika\", ABAIKAN TOTAL\nreturn [];"}}],"connections":{"Tanya CIKA":{"main":[[{"node":"Ada Jawaban?","type":"main","index":0}]]},"Ada Jawaban?":{"main":[[{"node":"Format Jawaban Ditemukan","type":"main","index":0}],[{"node":"Format Tidak Ditemukan","type":"main","index":0}]]},"Format Jawaban Ditemukan":{"main":[[{"node":"Send a text message","type":"main","index":0}]]},"Format Tidak Ditemukan":{"main":[[{"node":"Send a text message1","type":"main","index":0}]]},"Telegram Trigger":{"main":[[{"node":"Filter Grup","type":"main","index":0}]]},"If":{"main":[[{"node":"Tanya CIKA","type":"main","index":0}],[{"node":"HTTP Request","type":"main","index":0}]]},"HTTP Request":{"main":[[{"node":"Answer Query a callback","type":"main","index":0}]]},"Send a text message":{"main":[[]]},"Filter Grup":{"main":[[{"node":"If","type":"main","index":0}]]}},"nodeGroups":[],"settings":{"executionOrder":"v1","binaryMode":"separate"},"staticData":null,"pinData":{},"meta":{"templateCredsSetupCompleted":true},"tags":[],"shared":[{"role":"workflow:owner","workflowId":"dTA9FUgcnKQFRajZ","projectId":"YkcYmek54Iyhpeyj","project":{"id":"YkcYmek54Iyhpeyj","name":"disa cloud <disacloudshared.blue@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"87732261-d604-4d7e-b